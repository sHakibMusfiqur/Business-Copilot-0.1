# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_copilot?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-to-a-random-64-char-string"
JWT_REFRESH_SECRET="change-me-to-another-random-64-char-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
PORT=4000
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# Encryption (for sensitive fields)
ENCRYPTION_KEY="change-me-to-32-char-string-for-aes-256"

# Swagger
SWAGGER_ENABLED=true
SWAGGER_TITLE="Business Copilot API"
SWAGGER_DESCRIPTION="Enterprise ERP + AI Business Copilot API"
SWAGGER_VERSION="1.0"
