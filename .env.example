# ============================================================================
# Business Copilot — Environment Template
# Copy this file to `.env` and fill in local values. Never commit real secrets.
# Required variables cause the API to fail fast at startup if missing.
# Optional variables are left empty when the integration is not used.
# ============================================================================

# --- Application -------------------------------------------------------------
NODE_ENV="development"
PORT=4000
# Public base URLs. WEB_URL also seeds the API CORS allow-list.
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

# --- Database (REQUIRED) ----------------------------------------------------
# The API aborts at startup if DATABASE_URL is missing.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_copilot?schema=public"

# --- Redis (OPTIONAL; graceful degradation) ---------------------------------
# When unset, Redis-backed features (health, rate-limiter) safely fall back to
# in-memory/disabled behavior. Do not treat Redis as a hard startup dependency.
REDIS_URL="redis://localhost:6379"

# --- Authentication (REQUIRED) ----------------------------------------------
# REQUIRED. The API aborts if these are left empty.
# In production JWT secrets must be strong (>= 32 chars) and never placeholders.
# Generate strong values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# --- Encryption (for sensitive fields) --------------------------------------
# 32-char string for AES-256. Documented for providers that need it; not
# consumed by every module. Never commit a real key here.
ENCRYPTION_KEY="change-me-to-32-char-string-for-aes-256"

# --- Swagger (OPTIONAL; auto-disabled in production) ------------------------
SWAGGER_ENABLED=true
SWAGGER_TITLE="Business Copilot API"
SWAGGER_DESCRIPTION="Enterprise ERP + AI Business Copilot API"
SWAGGER_VERSION="1.0"

# --- AI (OPTIONAL) ----------------------------------------------------------
# When OPENAI_API_KEY is empty the AI provider is reported as not configured
# and AI-powered endpoints degrade gracefully.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

# --- Payment gateways (OPTIONAL) --------------------------------------------
# Stripe (used by the StripeProvider). Empty => free-trial fallback.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Seed credentials (required by `npm run db:seed`) -----------------------
# The seed aborts if any are missing. Development-only.
SEED_ADMIN_EMAIL="admin@business-copilot.com"
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_EMAIL="manager@business-copilot.com"
SEED_MANAGER_PASSWORD=""
SEED_USER_EMAIL="user@business-copilot.com"
SEED_USER_PASSWORD=""
SEED_SUPER_ADMIN_EMAIL="superadmin@business-copilot.com"
SEED_SUPER_ADMIN_PASSWORD=""
