
NODE_ENV="development"
PORT=4000
# Public base URLs. WEB_URL seeds the API CORS allow-list.
API_URL="http://localhost:4000"
WEB_URL="http://localhost:3000"

CORS_ORIGINS=""


DATABASE_URL="postgresql://postgres:postgres@localhost:5432/business_copilot?schema=public"


REDIS_URL="redis://localhost:6379"


JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"


ENCRYPTION_KEY="change-me-to-32-char-string-for-aes-256"

# --- Swagger (OPTIONAL; auto-disabled in production) ------------------------
SWAGGER_ENABLED=true
SWAGGER_TITLE="Business Copilot API"
SWAGGER_DESCRIPTION="Enterprise ERP + AI Business Copilot API"
SWAGGER_VERSION="1.0"


AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"


STRIPE_SECRET_KEY=""

STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- SSLCommerz (OPTIONAL; Bangladesh payment gateway) ----------------------
# Sandbox-only integration. Keep SSLCOMMERZ_IS_LIVE="false" until going live.
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"
# Fixed USD->BDT rate used to convert the backend USD plan price to the BDT charge.
SSLCOMMERZ_USD_TO_BDT_RATE="110"
# Optional IPN override; defaults to {API_URL}/api/billing/webhooks/sslcommerz
SSLCOMMERZ_IPN_URL=""

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587

# the connection uses implicit TLS (e.g. port 465).
SMTP_USER="musfiqu071rahman39@gmail.com"
SMTP_PASS=""
SMTP_SECURE=false
SMTP_FROM_EMAIL="musfiqu071rahman39@gmail.com"
SMTP_FROM_NAME="Business Copilot"


SEED_ADMIN_EMAIL="admin@business-copilot.com"
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_EMAIL="manager@business-copilot.com"
SEED_MANAGER_PASSWORD=""
SEED_USER_EMAIL="user@business-copilot.com"
SEED_USER_PASSWORD=""
SEED_SUPER_ADMIN_EMAIL="superadmin@business-copilot.com"
SEED_SUPER_ADMIN_PASSWORD=""

# --- Rate limiting (ALL OPTIONAL; safe defaults shown) ----------------------
# Global throttler trackers applied to every route unless @Throttle overrides.
THROTTLE_SHORT_TTL_MS=1000
THROTTLE_SHORT_LIMIT=10
THROTTLE_MEDIUM_TTL_MS=10000
THROTTLE_MEDIUM_LIMIT=50
THROTTLE_LONG_TTL_MS=60000
THROTTLE_LONG_LIMIT=200

# Per-endpoint tier profiles used by @Throttle on controllers.
THROTTLE_VERY_STRICT_LIMIT=5
THROTTLE_VERY_STRICT_TTL_MS=60000
THROTTLE_STRICT_LIMIT=10
THROTTLE_STRICT_TTL_MS=60000
THROTTLE_MODERATE_LIMIT=20
THROTTLE_MODERATE_TTL_MS=60000
THROTTLE_STANDARD_LIMIT=30
THROTTLE_STANDARD_TTL_MS=60000
THROTTLE_PUBLIC_LIMIT=60
THROTTLE_PUBLIC_TTL_MS=60000
THROTTLE_LOOSE_LIMIT=120
THROTTLE_LOOSE_TTL_MS=60000

# Auth backoff/block thresholds (per-IP + per-email + per-account). No hard
# lockout: the block expires and failures are slowed by progressive delays.
AUTH_THROTTLE_WINDOW_MS=900000
AUTH_THROTTLE_MAX_ATTEMPTS=5
AUTH_THROTTLE_BLOCK_MS=900000
AUTH_THROTTLE_DELAYS_MS=0,2000,5000,10000
