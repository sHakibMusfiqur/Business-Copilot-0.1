generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  IN
  OUT
  ADJUSTMENT
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SalesStatus {
  DRAFT
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum PurchaseStatus {
  DRAFT
  PENDING
  APPROVED
  RECEIVED
  CANCELLED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  SALES
  PURCHASE
  EXPENSE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
  NOTE
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TaxType {
  PERCENTAGE
  FIXED
}

model Organization {
  id             String    @id @default(cuid())
  name           String    @unique
  slug           String    @unique
  logo           String?
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  timezone       String    @default("UTC")
  locale         String    @default("en-US")
  isActive       Boolean   @default(true)
  suspendedAt    DateTime?
  deletedAt      DateTime?
  deletedBy      String?
  deletedReason  String?
  archivedAt     DateTime?
  archivedBy     String?
  archiveReason  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  users      User[]
  members    OrganizationMember[]
  auditLogs  AuditLog[]
  customers  Customer[]
  suppliers  Supplier[]
  products   Product[]
  invoices   Invoice[]
  purchaseOrders PurchaseOrder[]
  employees  Employee[]
  leads      Lead[]
  roles      Role[]
  inventoryTransactions InventoryTransaction[]
  salesOrders           SalesOrder[]
  accounts              Account[]
  journalEntries        JournalEntry[]
  receivables           Receivable[]
  payables              Payable[]
  payments              Payment[]
  subscription          Subscription?
  subscriptionPayments  SubscriptionPayment[]
  subscriptionInvoices  SubscriptionInvoice[]
  settings              OrganizationSettings?
  invitations           Invitation[]
  departments           Department[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationMemberRole @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  password       String
  name           String
  avatar         String?
  phone          String?
  role           UserRole   @default(USER)
  isActive       Boolean    @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  designation    String?
  managerId      String?
  manager        User?        @relation("DirectReports", fields: [managerId], references: [id])
  lastLoginAt    DateTime?
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  refreshTokens  RefreshToken[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  assignedLeads  Lead[]       @relation("AssignedUser")
  activities     Activity[]   @relation("CreatedByActivities")
  timelineEvents TimelineEvent[] @relation("CreatedByTimelineEvents")
  createdInvoices Invoice[]   @relation("CreatedByUser")
  inventoryTransactions InventoryTransaction[] @relation("CreatedByUserTransactions")
  purchaseOrders         PurchaseOrder[] @relation("CreatedByPurchaseOrders")
  salesOrders            SalesOrder[] @relation("CreatedBySalesOrders")
  journalEntries       JournalEntry[]       @relation("CreatedByJournalEntries")
  payments             Payment[]            @relation("CreatedByPayments")
  files                File[]
  memberOf             OrganizationMember[]
  roleAssignments      UserRoleAssignment[]
  systemSettingChanges SystemSettingVersion[]
  reports               User[]      @relation("DirectReports")
  inviteeInvitations    Invitation[] @relation("InvitedReportingManager")
  acceptedInvitation    Invitation? @relation("AcceptedInvitation")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  module      String
  label       String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model Role {
  id             String   @id @default(cuid())
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rolePermissions RolePermission[]
  userAssignments UserRoleAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  company        String?
  taxId          String?
  website        String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  notes          String?
  creditLimit    Decimal  @default(0)
  isActive       Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoices    Invoice[]
  leads       Lead[] @relation("ConvertedLeads")
  salesOrders SalesOrder[]
  receivables Receivable[]
  payments    Payment[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  email          String?
  phone          String?
  company        String?
  taxId          String?
  website        String?
  address        String?
  city           String?
  state          String?
  zipCode        String?
  country        String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  products       Product[]
  payables       Payable[]
  payments       Payment[]

  @@unique([organizationId, email])
  @@index([organizationId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  description String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]
}

model Product {
  id              String     @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  name            String
  sku             String
  barcode         String?
  brand           String?
  description     String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  unitPrice       Decimal    @default(0)
  costPrice       Decimal    @default(0)
  unit            String     @default("pcs")
  taxRate         Decimal    @default(0)
  minimumStock    Int        @default(0)
  maximumStock    Int        @default(0)
  imageUrl        String?
  isActive        Boolean    @default(true)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  inventory       Inventory[]
  invoiceItems    InvoiceItem[]
  purchaseItems   PurchaseOrderItem[]
  salesOrderItems SalesOrderItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model Warehouse {
  id          String   @id @default(cuid())
  name        String
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventories Inventory[]
}

model Inventory {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  quantity    Decimal  @default(0)
  minStock    Decimal  @default(0)
  maxStock    Decimal  @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
}

model InventoryTransaction {
  id               String          @id @default(cuid())
  organizationId   String
  organization     Organization    @relation(fields: [organizationId], references: [id])
  productId        String
  product          Product         @relation(fields: [productId], references: [id])
  type             TransactionType
  quantity         Int             @default(0)
  previousQuantity Int             @default(0)
  newQuantity      Int             @default(0)
  reference        String?
  notes            String?
  createdById      String
  createdBy        User            @relation("CreatedByUserTransactions", fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())

  @@index([organizationId])
  @@index([productId])
  @@index([createdAt])
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  type            InvoiceType   @default(SALES)
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  issueDate       DateTime      @default(now())
  dueDate         DateTime?
  status          OrderStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @default(0)
  taxTotal        Decimal       @default(0)
  discountTotal   Decimal       @default(0)
  total           Decimal       @default(0)
  notes           String?
  createdById     String
  createdBy       User          @relation("CreatedByUser", fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items InvoiceItem[]

  @@index([organizationId])
  @@index([customerId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  description String
  quantity  Decimal @default(1)
  unitPrice Decimal @default(0)
  taxRate   Decimal @default(0)
  taxAmount Decimal @default(0)
  discount  Decimal @default(0)
  total     Decimal @default(0)

  @@index([invoiceId])
}

model PurchaseOrder {
  id              String         @id @default(cuid())
  orderNumber     String         @unique
  organizationId  String
  organization    Organization   @relation(fields: [organizationId], references: [id])
  supplierId      String?
  supplier        Supplier?      @relation(fields: [supplierId], references: [id])
  orderDate       DateTime       @default(now())
  status          PurchaseStatus @default(DRAFT)
  subtotal        Decimal        @default(0)
  discount        Decimal        @default(0)
  tax             Decimal        @default(0)
  shippingCost    Decimal        @default(0)
  total           Decimal        @default(0)
  notes           String?
  createdById     String
  createdBy       User           @relation("CreatedByPurchaseOrders", fields: [createdById], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items    PurchaseOrderItem[]
  payables Payable[]

  @@index([organizationId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product?      @relation(fields: [productId], references: [id])
  description     String
  quantity        Decimal       @default(1)
  unitCost        Decimal       @default(0)
  discount        Decimal       @default(0)
  tax             Decimal       @default(0)
  lineTotal       Decimal       @default(0)

  @@index([purchaseOrderId])
}

model SalesOrder {
  id              String       @id @default(cuid())
  orderNumber     String       @unique
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id])
  orderDate       DateTime     @default(now())
  status          SalesStatus  @default(DRAFT)
  subtotal        Decimal      @default(0)
  discount        Decimal      @default(0)
  tax             Decimal      @default(0)
  shippingCost    Decimal      @default(0)
  total           Decimal      @default(0)
  notes           String?
  createdById     String
  createdBy       User         @relation("CreatedBySalesOrders", fields: [createdById], references: [id])
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items       SalesOrderItem[]
  receivables Receivable[]

  @@index([organizationId])
  @@index([customerId])
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id])
  description  String
  quantity     Decimal    @default(1)
  unitPrice    Decimal    @default(0)
  discount     Decimal    @default(0)
  tax          Decimal    @default(0)
  lineTotal    Decimal    @default(0)

  @@index([salesOrderId])
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum ReceivableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PayableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentType {
  CUSTOMER_PAYMENT
  SUPPLIER_PAYMENT
}

model Account {
  id             String       @id @default(cuid())
  code           String
  name           String
  type           AccountType
  parentId       String?
  parent         Account?     @relation("AccountHierarchy", fields: [parentId], references: [id])
  childAccounts  Account[]    @relation("AccountHierarchy")
  description    String?
  isActive       Boolean      @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  journalEntryLines JournalEntryLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentId])
}

model JournalEntry {
  id              String              @id @default(cuid())
  entryNumber     String              @unique
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id])
  date            DateTime            @default(now())
  description     String
  status          JournalEntryStatus  @default(DRAFT)
  referenceId     String?
  referenceType   String?
  createdById     String
  createdBy       User                @relation("CreatedByJournalEntries", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  lines JournalEntryLine[]

  @@index([organizationId])
  @@index([date])
}

model JournalEntryLine {
  id              String       @id @default(cuid())
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId       String
  account         Account      @relation(fields: [accountId], references: [id])
  description     String?
  debit           Decimal      @default(0)
  credit          Decimal      @default(0)

  @@index([journalEntryId])
  @@index([accountId])
}

model Receivable {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id])
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  salesOrderId    String?
  salesOrder      SalesOrder?      @relation(fields: [salesOrderId], references: [id])
  invoiceNumber   String
  dueDate         DateTime
  totalAmount     Decimal          @default(0)
  paidAmount      Decimal          @default(0)
  status          ReceivableStatus @default(PENDING)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payments PaymentAllocation[]

  @@index([organizationId])
  @@index([customerId])
}

model Payable {
  id               String        @id @default(cuid())
  organizationId   String
  organization     Organization  @relation(fields: [organizationId], references: [id])
  supplierId       String?
  supplier         Supplier?     @relation(fields: [supplierId], references: [id])
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  billNumber       String
  dueDate          DateTime
  totalAmount      Decimal       @default(0)
  paidAmount       Decimal       @default(0)
  status           PayableStatus @default(PENDING)
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  payments PaymentAllocation[]

  @@index([organizationId])
  @@index([supplierId])
}

model Payment {
  id             String      @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           PaymentType
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id])
  supplierId     String?
  supplier       Supplier?   @relation(fields: [supplierId], references: [id])
  amount         Decimal     @default(0)
  paymentDate    DateTime    @default(now())
  reference      String?
  notes          String?
  createdById    String
  createdBy      User        @relation("CreatedByPayments", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  allocations PaymentAllocation[]

  @@index([organizationId])
  @@index([customerId])
  @@index([supplierId])
}

model PaymentAllocation {
  id            String     @id @default(cuid())
  paymentId     String
  payment       Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  receivableId  String?
  receivable    Receivable? @relation(fields: [receivableId], references: [id])
  payableId     String?
  payable       Payable?   @relation(fields: [payableId], references: [id])
  amount        Decimal    @default(0)

  @@index([paymentId])
  @@index([receivableId])
  @@index([payableId])
}

model Department {
  id             String     @id @default(cuid())
  name           String
  code           String     @unique
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  managerId      String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  employees    Employee[]
  users        User[]
  invitations  Invitation[]
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  email          String
  name           String
  departmentId   String?
  department     Department?      @relation(fields: [departmentId], references: [id])
  designation    String?
  managerId      String?
  manager        User?            @relation("InvitedReportingManager", fields: [managerId], references: [id])
  roleIds        String[]
  tokenExpiresAt DateTime
  status         InvitationStatus @default(PENDING)
  acceptedAt     DateTime?
  acceptedUserId String?       @unique
  acceptedUser   User?         @relation("AcceptedInvitation", fields: [acceptedUserId], references: [id])
  resendCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([status])
}

model Employee {
  id             String     @id @default(cuid())
  employeeCode   String     @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  firstName      String
  lastName       String
  email          String     @unique
  phone          String?
  gender         Gender?
  dateOfBirth    DateTime?
  hireDate       DateTime   @default(now())
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  position       String?
  salary         Decimal    @default(0)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  leaves         Leave[]
  payrolls       Payroll[]

  @@index([organizationId])
  @@index([departmentId])
}

model Leave {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  type        String       @default("ANNUAL")
  reason      String?
  status      LeaveStatus  @default(PENDING)
  approvedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([employeeId])
}

model Payroll {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  basicSalary Decimal  @default(0)
  allowances  Decimal  @default(0)
  deductions  Decimal  @default(0)
  tax         Decimal  @default(0)
  netSalary   Decimal  @default(0)
  paymentDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}

model Lead {
  id                    String     @id @default(cuid())
  organizationId        String
  organization          Organization @relation(fields: [organizationId], references: [id])
  leadNumber            String     @unique
  name                  String
  company               String?
  email                 String?
  phone                 String?
  source                String?
  status                LeadStatus @default(NEW)
  estimatedValue        Decimal    @default(0)
  assignedToId          String?
  assignedTo            User?      @relation("AssignedUser", fields: [assignedToId], references: [id])
  notes                 String?
  convertedToCustomerId String?
  convertedToCustomer   Customer?  @relation("ConvertedLeads", fields: [convertedToCustomerId], references: [id])
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  deletedAt             DateTime?

  activities      Activity[]
  timelineEvents  TimelineEvent[]

  @@index([organizationId])
  @@index([status])
  @@index([assignedToId])
  @@index([deletedAt])
}

model Activity {
  id          String       @id @default(cuid())
  leadId      String
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        ActivityType
  title       String
  description String?
  dueDate     DateTime?
  completed   Boolean      @default(false)
  createdById String
  createdBy   User         @relation("CreatedByActivities", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([leadId])
  @@index([createdById])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id])
  title   String
  message String
  type    NotificationType @default(INFO)
  read    Boolean          @default(false)
  link    String?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([read])
}

model File {
  id          String   @id @default(cuid())
  originalName String
  fileName    String
  mimeType    String
  size        Int
  path        String
  url         String?
  uploadedById String?
  uploadedBy  User?    @relation(fields: [uploadedById], references: [id])
  entityType  String?
  entityId    String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
}

model AuditLog {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  action         String
  entity         String?
  entityId       String?
  status         String        @default("SUCCESS")
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([organizationId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@index([organizationId, action])
}

model TimelineEvent {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        String
  description String
  metadata    Json?
  createdById String
  createdBy   User     @relation("CreatedByTimelineEvents", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum SubscriptionInterval {
  MONTHLY
  YEARLY
}

model SubscriptionPlan {
  id              String                @id @default(cuid())
  name            String
  slug            String                @unique
  description     String?
  price           Decimal               @default(0)
  yearlyPrice     Decimal?
  currency        String                @default("USD")
  interval        SubscriptionInterval  @default(MONTHLY)
  freeTrialDays   Int                   @default(30)
  aiCredits       Int                   @default(0)
  reportsEnabled  Boolean               @default(false)
  apiAccess       Boolean               @default(false)
  integrations    Json?
  prioritySupport Boolean               @default(false)
  customBranding  Boolean               @default(false)
  securityFeatures Json?
  recommended     Boolean               @default(false)
  sortOrder       Int                   @default(0)
  features        Json?
  modules         Json?
  maxUsers        Int                   @default(5)
  maxStorage      Int                   @default(1024)
  maxCustomers    Int                   @default(100)
  maxProducts     Int                   @default(100)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  subscriptions Subscription[]
  payments       SubscriptionPayment[]
}

model Subscription {
  id                  String             @id @default(cuid())
  organizationId      String             @unique
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planId              String
  plan                SubscriptionPlan   @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(TRIALING)
  billingInterval     SubscriptionInterval @default(MONTHLY)
  currentPeriodStart  DateTime           @default(now())
  currentPeriodEnd    DateTime
  trialEndsAt         DateTime?
  canceledAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  payments SubscriptionPayment[]
  invoices SubscriptionInvoice[]

  @@index([organizationId])
  @@index([planId])
  @@index([status])
}

enum SubscriptionPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELLED
}

enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
}

model SubscriptionPayment {
  id               String                    @id @default(cuid())
  organizationId   String
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription?             @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  planId           String?
  plan             SubscriptionPlan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  amount           Decimal
  currency         String                    @default("USD")
  billingInterval  SubscriptionInterval      @default(MONTHLY)
  status           SubscriptionPaymentStatus @default(PENDING)
  gateway          String?
  transactionRef   String?
  gatewayData      Json?
  paidAt           DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  invoices SubscriptionInvoice[]

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
}

model SubscriptionInvoice {
  id               String                      @id @default(cuid())
  organizationId   String
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     Subscription?               @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  paymentId        String?
  payment          SubscriptionPayment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceNumber    String
  amount           Decimal
  currency         String                      @default("USD")
  billingInterval  SubscriptionInterval        @default(MONTHLY)
  status           SubscriptionInvoiceStatus   @default(DRAFT)
  issuedAt         DateTime                    @default(now())
  dueAt            DateTime?
  paidAt           DateTime?
  pdfUrl           String?
  metadata         Json?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([organizationId])
  @@index([subscriptionId])
  @@index([status])
  @@unique([organizationId, invoiceNumber])
}

model PaymentGateway {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isEnabled Boolean  @default(false)
  config    Json?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
}

model OrganizationSettings {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([organizationId])
}

model SystemSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model SystemSettingVersion {
  id          String   @id @default(cuid())
  settingKey  String
  oldValue    Json?
  newValue    Json?
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  reason      String?
  version     Int
  createdAt   DateTime @default(now())

  @@index([settingKey])
  @@index([createdAt])
}

model IdempotencyRecord {
  id        String   @id @default(cuid())
  key       String   @unique
  response  Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model ChecklistItem {
  id          String    @id @default(cuid())
  sessionId   String
  itemId      String
  label       String
  icon        String?
  href        String?
  completed   Boolean   @default(false)
  skippable   Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([sessionId])
}

model OnboardingSession {
  id               String    @id @default(cuid())
  userId           String?
  email            String
  name             String
  version          Int       @default(1)
  currentStep      Int       @default(0)
  completedSteps   Json?     @default("[]")
  selectedIndustry String?
  selectedCategory String?
  selectedCategories Json?    @default("[]")
  orgName          String?
  orgEmail         String?
  orgPhone         String?
  orgWebsite       String?
  orgCountry       String?
  orgState         String?
  orgCity          String?
  orgAddress       String?
  orgTimezone      String?
  orgCurrency      String?
  orgLanguage      String?
  businessProfile  Json?
  selectedModules  Json?     @default("[]")
  aiEnabled        Boolean   @default(false)
  aiLanguage       String?
  aiPersonality    String?
  selectedPlanId   String?
  planInterval     String?   @default("MONTHLY")
  subscriptionId   String?
  provisionStatus  String    @default("PENDING")
  provisionData    Json?
  organizationId   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([userId])
  @@index([organizationId])
}
